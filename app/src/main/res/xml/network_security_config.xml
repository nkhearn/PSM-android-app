<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Since the user can configure any local IP/host, we allow cleartext traffic broadly
         but it is intended for local network access to the Pi Solar Monitor. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
